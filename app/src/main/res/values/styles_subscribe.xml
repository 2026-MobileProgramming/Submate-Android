<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 구독 목록 상단 필터 칩 -->
    <style name="subscribe_filter_chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/subscribe_chip_height</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_subscribe_chip</item>
        <item name="android:textColor">@color/subscribe_chip_text</item>
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 구독 상세 화면 항목 제목 (카테고리, 서비스명 ...) -->
    <style name="subscribe_detail_label" parent="typo_body_b3">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:textColor">@color/appblack</item>
    </style>

    <!-- 드롭다운처럼 보이는 입력칸의 글자 -->
    <style name="subscribe_detail_field_text" parent="typo_body_m2">
        <item name="android:textColor">@color/gray800</item>
        <item name="android:textColorHint">@color/gray400</item>
    </style>

    <!-- 결제일 칸 안의 숫자(월/일) 입력칸 -->
    <style name="subscribe_detail_date_input" parent="subscribe_detail_field_text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:minWidth">24dp</item>
        <item name="android:background">@null</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:hint">00</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">2</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="subscribe_fab_shape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>

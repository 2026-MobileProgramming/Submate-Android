<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/appwhite">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <include layout="@layout/setting_header" />
        <LinearLayout android:id="@+id/setting_account" android:layout_width="match_parent" android:layout_height="60dp" android:background="@color/gray50" android:clickable="true" android:focusable="true" android:gravity="center_vertical">
            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="20dp" android:contentDescription="계정" android:src="@drawable/ic_setting_account" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="계정" android:textColor="@color/appblack" style="@style/typo_body_m1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/setting_list" android:layout_width="match_parent" android:layout_height="60dp" android:clickable="true" android:focusable="true" android:gravity="center_vertical">
            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="20dp" android:contentDescription="내 구독 현황" android:src="@drawable/ic_setting_list" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="내 구독 현황" android:textColor="@color/appblack" style="@style/typo_body_m1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/setting_notification" android:layout_width="match_parent" android:layout_height="60dp" android:background="@color/gray50" android:clickable="true" android:focusable="true" android:gravity="center_vertical">
            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="20dp" android:contentDescription="알림 설정" android:src="@drawable/ic_setting_notification" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="알림 설정" android:textColor="@color/appblack" style="@style/typo_body_m1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/setting_access" android:layout_width="match_parent" android:layout_height="60dp" android:clickable="true" android:focusable="true" android:gravity="center_vertical">
            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="20dp" android:contentDescription="앱 내 권한" android:src="@drawable/ic_setting_access" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="앱 내 권한" android:textColor="@color/appblack" style="@style/typo_body_m1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/setting_contact" android:layout_width="match_parent" android:layout_height="60dp" android:background="@color/gray50" android:clickable="true" android:focusable="true" android:gravity="center_vertical">
            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="20dp" android:contentDescription="문의하기" android:src="@drawable/ic_setting_contact" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="문의하기" android:textColor="@color/appblack" style="@style/typo_body_m1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

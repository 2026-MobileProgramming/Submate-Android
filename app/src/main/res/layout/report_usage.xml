<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutUsageReport"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="visible">

    <!-- 총 사용 시간 카드 -->
    <LinearLayout
        android:id="@+id/layoutUsageSummaryCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:background="@drawable/bg_usage_report_card">

        <!-- 카드 제목 -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="이번 달 총 사용 시간"
            android:textColor="@color/gray500"
            android:textAppearance="@style/ReportText_Caption" />

        <!-- 총 사용 시간 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvTotalUsageTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="26시간"
            android:textColor="@color/appblack"
            android:textAppearance="@style/ReportText_Body1" />

        <!-- 서비스별 사용량 목록 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUsageReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />
        <!-- 사용량 데이터가 없을 때 표시 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvUsageEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="32dp"
            android:text="해당 월의 사용량 데이터가 없어요."
            android:textColor="@color/gray500"
            android:textAppearance="@style/ReportText_Caption"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 사용량 경고 카드 -->
    <LinearLayout
        android:id="@+id/layoutUsageWarningCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:background="@drawable/bg_usage_warning"
        android:minHeight="128dp"
        android:visibility="gone">

        <!-- 경고 제목 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="!"
                android:textColor="@color/appwhite"
                android:textAppearance="@style/ReportText_Caption"
                android:background="@drawable/bg_usage_warning_icon" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="사용량이 적어요"
                android:textColor="@color/appblack"
                android:textAppearance="@style/ReportText_Body4" />

        </LinearLayout>

        <!-- 경고 내용 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvUsageWarningMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@color/gray700"
            android:textAppearance="@style/ReportText_Caption" />

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:minHeight="64dp"
    android:paddingTop="12dp">

    <View
        android:id="@+id/view_category_dot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:background="@drawable/bg_subscribe_dot"
        app:layout_constraintBottom_toBottomOf="@id/tv_subscribe_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_subscribe_name" />

    <TextView
        android:id="@+id/tv_subscribe_name"
        style="@style/typo_body_m2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/appblack"
        app:layout_constraintEnd_toStartOf="@id/ll_subscribe_price"
        app:layout_constraintStart_toEndOf="@id/view_category_dot"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_subscribe_schedule"
        style="@style/typo_cap_r1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/gray500"
        app:layout_constraintEnd_toEndOf="@id/tv_subscribe_name"
        app:layout_constraintStart_toStartOf="@id/tv_subscribe_name"
        app:layout_constraintTop_toBottomOf="@id/tv_subscribe_name" />

    <LinearLayout
        android:id="@+id/ll_subscribe_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_subscribe_price"
            style="@style/typo_body_b2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/appblack" />

        <TextView
            android:id="@+id/tv_subscribe_converted_price"
            style="@style/typo_cap_r1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:textColor="@color/gray800"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_subscribe_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/pretendard_medium"
        android:paddingStart="6dp"
        android:paddingTop="1dp"
        android:paddingEnd="6dp"
        android:paddingBottom="1dp"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_subscribe_price" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_subscribe_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tv_subscribe_schedule,tv_subscribe_status" />

    <!-- 구분선 -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/gray100"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrier_subscribe_bottom" />
</androidx.constraintlayout.widget.ConstraintLayout>

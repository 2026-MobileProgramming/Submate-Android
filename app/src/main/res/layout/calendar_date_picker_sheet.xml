<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_calendar_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- 손잡이 -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_calendar_sheet_handle" />

    <TextView
        style="@style/typo_body_b2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="날짜 선택"
        android:textColor="@color/appblack" />

    <!-- 월, 연, 전체 탭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_calendar_tab_container"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/tv_picker_tab_month"
            style="@style/typo_body_b3"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_calendar_tab_selected"
            android:gravity="center"
            android:text="월"
            android:textColor="@color/gray800" />

        <TextView
            android:id="@+id/tv_picker_tab_year"
            style="@style/typo_body_r1"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="연"
            android:textColor="@color/gray500" />

        <TextView
            android:id="@+id/tv_picker_tab_all"
            style="@style/typo_body_r1"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="전체"
            android:textColor="@color/gray500" />
    </LinearLayout>

    <!-- 연도 이동 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_picker_prev_year"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="이전 연도"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_calendar_arrow_left"
            android:tint="@color/gray600" />

        <TextView
            android:id="@+id/tv_picker_year"
            style="@style/typo_body_b2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/appblack" />

        <ImageButton
            android:id="@+id/btn_picker_next_year"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="다음 연도"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_calendar_arrow_right"
            android:tint="@color/gray600" />
    </LinearLayout>

    <!-- 1~12월 -->
    <LinearLayout
        android:id="@+id/ll_picker_months"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <com.example.submate.presentation.common.view.SubmateButton
        android:id="@+id/btn_picker_move"
        style="@style/typo_body_m1"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_submate_button"
        android:textColor="@color/appwhite" />

    <!-- 전체 탭  -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/sv_picker_overview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:visibility="gone">
        <include layout="@layout/calendar_overview" />
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/appwhite"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:layout_width="364dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="비밀번호 재설정"
        android:textColor="@color/appblack"
        style="@style/typo_title_b1" />

    <LinearLayout
        android:layout_width="364dp"
        android:layout_height="4dp"
        android:layout_marginTop="25dp"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/pri700" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@color/gray100" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@color/gray100"  />
    </LinearLayout>

    <TextView
        android:layout_width="364dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="1. 가입하신 이메일 주소를 입력해 주세요"
        android:textColor="@color/appblack"
        style="@style/typo_body_m1" />

    <com.example.submate.presentation.common.view.SubmateEditText
        android:id="@+id/et_email"
        android:layout_width="364dp"
        android:layout_height="56dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_submate_edittext"
        android:hint="이메일 주소"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="20dp"
        style="@style/typo_body_m1" />

    <com.example.submate.presentation.common.view.SubmateButton
        android:id="@+id/btn_send_code"
        android:layout_width="364dp"
        android:layout_height="56dp"
        android:layout_marginTop="35dp"
        android:background="@drawable/bg_submate_button"
        android:text="인증 코드 전송"
        android:textColor="@color/appwhite"
        style="@style/typo_body_m1" />

</LinearLayout>
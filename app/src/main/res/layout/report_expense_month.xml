<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutExpenseReport"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- 월별 구독료 요약 카드 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/bg_usage_report_card">

        <!-- 카드 제목 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="이번 달 총 구독료"
            android:textColor="@color/gray500"
            android:textSize="10sp" />

        <!-- 총 구독료 -->
        <TextView
            android:id="@+id/tvTotalExpense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="₩19,375"
            android:textColor="@color/appblack"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 지난달 대비 증감 -->
        <TextView
            android:id="@+id/tvExpenseComparison"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="지난달보다 ▲ ₩1,500"
            android:textColor="@color/error800"
            android:textSize="9sp" />

        <!-- 카테고리별 지출 비율 막대 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="51"
                android:background="@color/pastel_blue" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="41"
                android:background="@color/pastel_red" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="8"
                android:background="@color/pastel_yellow" />

        </LinearLayout>

        <!-- 카테고리 범례 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="● AI 51%"
                android:textColor="@color/gray500"
                android:textSize="9sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="● OTT 41%"
                android:textColor="@color/gray500"
                android:textSize="9sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● 음식 8%"
                android:textColor="@color/gray500"
                android:textSize="9sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- 서비스별 지출 카드 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="@drawable/bg_expense_list_card">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="서비스별 지출"
            android:textColor="@color/appblack"
            android:textSize="11sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExpenseReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

    </LinearLayout>

</LinearLayout>

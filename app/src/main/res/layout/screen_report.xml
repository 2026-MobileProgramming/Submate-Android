<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/appwhite">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 상단 제목 -->
            <TextView
                android:id="@+id/tvReportTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="리포트"
                android:textColor="@color/appblack"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <!-- 리포트 종류 선택 -->
            <LinearLayout
                android:id="@+id/layoutReportType"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_report_type_container"
                android:padding="4dp">

                <!-- 사용량 탭 -->
                <TextView
                    android:id="@+id/btnUsageReport"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="사용량"
                    android:textColor="@color/appblack"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_report_type_selected" />

                <!-- 누적 지출 탭 -->
                <TextView
                    android:id="@+id/btnExpenseReport"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="누적 지출"
                    android:textColor="@color/gray500"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:background="@android:color/transparent" />

            </LinearLayout>

            <!-- 기간 선택 -->
            <LinearLayout
                android:id="@+id/layoutPeriod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- 월 -->
                <TextView
                    android:id="@+id/btnPeriodMonth"
                    style="@style/subscribe_filter_chip"
                    android:text="월" />

                <!-- 연 -->
                <TextView
                    android:id="@+id/btnPeriodYear"
                    style="@style/subscribe_filter_chip"
                    android:text="연" />

                <!-- 전체 -->
                <TextView
                    android:id="@+id/btnPeriodAll"
                    style="@style/subscribe_filter_chip"
                    android:text="전체" />

            </LinearLayout>


            <!-- 리포트 콘텐츠 영역 -->
            <LinearLayout
                android:id="@+id/reportContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <!-- 공통 월 이동 영역 -->
                <LinearLayout
                    android:id="@+id/layoutReportPeriodNavigation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/btnPreviousMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="‹"
                        android:textSize="16sp"
                        android:textColor="@color/gray500"
                        android:paddingEnd="8dp" />

                    <TextView
                        android:id="@+id/tvReportMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10월"
                        android:textColor="@color/appblack"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnNextMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="16sp"
                        android:textColor="@color/gray500"
                        android:paddingStart="8dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvReportDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="앱 사용 시간 (월)"
                        android:textColor="@color/gray500"
                        android:textSize="10sp" />

                </LinearLayout>

                <!-- 사용량 화면 -->
                <LinearLayout
                    android:id="@+id/layoutUsageReport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">


                    <!-- 총 사용 시간 카드 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="@drawable/bg_usage_report_card">

                        <!-- 카드 제목 -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="이번 달 총 사용 시간"
                            android:textColor="@color/gray500"
                            android:textSize="10sp" />

                        <!-- 총 사용 시간 -->
                        <TextView
                            android:id="@+id/tvTotalUsageTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="26시간"
                            android:textColor="@color/appblack"
                            android:textSize="18sp"
                            android:textStyle="bold" />


                        <!-- 서비스별 사용량 목록 -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvUsageReport"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never" />

                    </LinearLayout>

                    <!-- 사용량 경고 카드 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="@drawable/bg_usage_warning"
                        android:minHeight="110dp">

                        <!-- 경고 제목 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:gravity="center"
                                android:text="!"
                                android:textColor="@color/appwhite"
                                android:textSize="12sp"
                                android:background="@drawable/bg_usage_warning_icon" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="사용량이 적어요"
                                android:textColor="@color/appblack"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- 경고 내용 -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="라프텔을 한 달 동안 거의 사용하지 않았어요.\n구독 유지 여부를 다시 한번 확인해 보세요."
                            android:textColor="@color/gray700"
                            android:textSize="9sp" />

                    </LinearLayout>

                </LinearLayout>



                <!-- 누적 지출 화면 -->
                <LinearLayout
                    android:id="@+id/layoutExpenseReport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- 월별 구독료 요약 카드 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="@drawable/bg_usage_report_card">

                        <!-- 카드 제목 -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="이번 달 총 구독료"
                            android:textColor="@color/gray500"
                            android:textSize="10sp" />

                        <!-- 총 구독료 -->
                        <TextView
                            android:id="@+id/tvTotalExpense"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="₩19,375"
                            android:textColor="@color/appblack"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <!-- 지난달 대비 증감 -->
                        <TextView
                            android:id="@+id/tvExpenseComparison"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="지난달보다 ▲ ₩1,500"
                            android:textColor="@color/error800"
                            android:textSize="9sp" />

                        <!-- 카테고리별 지출 비율 막대 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="51"
                                android:background="@color/pastel_blue" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="3dp"
                                android:layout_weight="41"
                                android:background="@color/pastel_red" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="3dp"
                                android:layout_weight="8"
                                android:background="@color/pastel_yellow" />

                        </LinearLayout>

                        <!-- 카테고리 범례 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="● AI 51%"
                                android:textColor="@color/gray500"
                                android:textSize="9sp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="● OTT 41%"
                                android:textColor="@color/gray500"
                                android:textSize="9sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="● 음식 8%"
                                android:textColor="@color/gray500"
                                android:textSize="9sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- 서비스별 지출 카드 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:background="@drawable/bg_expense_list_card">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="서비스별 지출"
                            android:textColor="@color/appblack"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvExpenseReport"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never" />

                    </LinearLayout>

                </LinearLayout>


                <!-- 연간 지출 화면 -->
                <LinearLayout
                    android:id="@+id/layoutAnnualExpenseReport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- 연간 구독료 요약 카드 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="@drawable/bg_usage_report_card">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="올해 총 구독료"
                            android:textColor="@color/gray500"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvAnnualTotalExpense"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="₩243,000"
                            android:textColor="@color/appblack"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAnnualAverageExpense"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="월평균 ₩24,300"
                            android:textColor="@color/gray500"
                            android:textSize="10sp" />

                    </LinearLayout>

                    <!-- 월별 지출 그래프 카드 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="@drawable/bg_expense_list_card">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="월별 지출"
                            android:textColor="@color/appblack"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <!-- 그래프 영역: 막대는 Java 코드로 생성 예정 -->
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fillViewport="false"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/layoutAnnualMonthlyChart"
                                android:layout_width="wrap_content"
                                android:layout_height="150dp"
                                android:orientation="horizontal"
                                android:gravity="bottom"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp" />

                        </HorizontalScrollView>

                        <!-- 카테고리 범례 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="● OTT"
                                android:textColor="@color/gray500"
                                android:textSize="9sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:text="● AI"
                                android:textColor="@color/gray500"
                                android:textSize="9sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:text="● 음식"
                                android:textColor="@color/gray500"
                                android:textSize="9sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- 카테고리별 지출 카드 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="@drawable/bg_expense_list_card">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="카테고리별 지출"
                            android:textColor="@color/appblack"
                            android:textSize="11sp"
                            android:textStyle="bold" />


                        <LinearLayout
                            android:id="@+id/layoutAnnualCategoryChart"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="16dp">

                            <!-- 왼쪽: 도넛 그래프 -->
                            <com.example.submate.presentation.report.view.AnnualExpenseDonutView
                                android:id="@+id/annualDonutChart"
                                android:layout_width="120dp"
                                android:layout_height="120dp" />

                            <!-- 오른쪽: 카테고리별 지출 목록 -->
                            <LinearLayout
                                android:id="@+id/layoutAnnualCategoryLegend"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp" />

                        </LinearLayout>


                    </LinearLayout>

                </LinearLayout>

                <!-- 전체 누적 지출 리포트 -->
                <LinearLayout
                    android:id="@+id/layoutAllExpenseReport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    >

                    <TextView
                        android:id="@+id/tvAllExpensePeriod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="2024.03 ~ 현재"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/appblack"/>

                    <!-- 전체 누적 금액 + 연도별 그래프 카드 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="@drawable/bg_usage_report_card">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="지금까지 총 구독료"
                            android:textSize="11sp"
                            android:textColor="@color/gray500"/>

                        <TextView
                            android:id="@+id/tvAllTotalExpense"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="₩412,300"
                            android:textSize="25sp"
                            android:textStyle="bold"
                            android:textColor="@color/appblack"/>

                        <TextView
                            android:id="@+id/tvAllServiceCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="구독 서비스 6개"
                            android:textSize="10sp"
                            android:textColor="@color/gray500"/>

                        <!-- 연도별 막대그래프 -->
                        <LinearLayout
                            android:id="@+id/layoutAllYearlyChart"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:gravity="bottom|center_horizontal"/>

                    </LinearLayout>

                    <!-- 카테고리별 누적 카드 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:background="@color/appwhite">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="카테고리별 누적"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/appblack"/>

                        <!-- 카테고리 비율 막대 -->
                        <LinearLayout
                            android:id="@+id/layoutAllCategoryBar"
                            android:layout_width="match_parent"
                            android:layout_height="7dp"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal"/>

                        <!-- 카테고리별 금액 목록 -->
                        <LinearLayout
                            android:id="@+id/layoutAllCategoryList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical"/>

                    </LinearLayout>

                    <!-- 해지 서비스 안내 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:background="@color/sec50">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:gravity="center"
                            android:text="!"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/appwhite"
                            android:background="@color/sec500"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="해지한 서비스도 포함돼요"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/appblack"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="종료된 구독의 지출도 전체 누적에 합산됩니다."
                                android:textSize="9sp"
                                android:textColor="@color/gray600"/>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>




            </LinearLayout>


        </LinearLayout>

    </ScrollView>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/appwhite">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 상단 제목 -->
            <TextView
                android:id="@+id/tvReportTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="리포트"
                android:textColor="#222222"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <!-- 리포트 종류 선택 -->
            <LinearLayout
                android:id="@+id/layoutReportType"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_report_type_container"
                android:padding="4dp">

                <!-- 사용량 탭 -->
                <TextView
                    android:id="@+id/btnUsageReport"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="사용량"
                    android:textColor="@color/appblack"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_report_type_selected" />

                <!-- 누적 지출 탭 -->
                <TextView
                    android:id="@+id/btnExpenseReport"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="누적 지출"
                    android:textColor="@color/gray500"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:background="@android:color/transparent" />

            </LinearLayout>

            <!-- 기간 선택 -->
            <LinearLayout
                android:id="@+id/layoutPeriod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- 10일 -->
                <TextView
                    android:id="@+id/btnPeriod10Days"
                    style="@style/subscribe_filter_chip"
                    android:text="월" />

                <!-- 월 -->
                <TextView
                    android:id="@+id/btnPeriodMonth"
                    style="@style/subscribe_filter_chip"
                    android:text="연" />

                <!-- 전체 -->
                <TextView
                    android:id="@+id/btnPeriodAll"
                    style="@style/subscribe_filter_chip"
                    android:text="전체" />

            </LinearLayout>


            <!-- 리포트 콘텐츠 영역 -->
            <FrameLayout
                android:id="@+id/reportContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <!-- 사용량 화면 -->
                <LinearLayout
                    android:id="@+id/layoutUsageReport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="사용량 리포트"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#222222" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="사용량 화면 콘텐츠 영역"
                        android:textSize="14sp"
                        android:textColor="#888888" />

                </LinearLayout>

                <!-- 누적 지출 화면 -->
                <LinearLayout
                    android:id="@+id/layoutExpenseReport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="누적 지출 리포트"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#222222" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="누적 지출 화면 콘텐츠 영역"
                        android:textSize="14sp"
                        android:textColor="#888888" />

                </LinearLayout>

            </FrameLayout>


        </LinearLayout>

    </ScrollView>

</FrameLayout>

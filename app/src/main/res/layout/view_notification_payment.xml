        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="오늘은 라프텔 결제일이에요" android:textColor="@color/appblack" style="@style/typo_body_m1" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="(10/11) ₩3,725원이 결제될 예정이에요" android:textColor="@color/gray600" style="@style/typo_body_m2" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_calendar_payment_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/tv_calendar_payment_logo"
        style="@style/typo_body_b2"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_calendar_logo"
        android:gravity="center"
        android:textColor="@color/appwhite" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_calendar_payment_name"
            style="@style/typo_body_b3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gray800" />

        <TextView
            android:id="@+id/tv_calendar_payment_category"
            style="@style/typo_cap_r1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/gray500" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_calendar_payment_price"
        style="@style/typo_body_b3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/appblack" />
</LinearLayout>

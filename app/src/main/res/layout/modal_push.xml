<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="350dp" android:layout_height="380dp" android:background="@drawable/bg_modal" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
    <Space android:layout_width="match_parent" android:layout_height="88dp" />

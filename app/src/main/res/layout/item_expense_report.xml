<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <!-- 아이콘 / 서비스명 / 막대그래프 / 가격 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 서비스 아이콘 -->
        <TextView
            android:id="@+id/tvExpenseServiceIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="N"
            android:textColor="@color/appwhite"
            android:textSize="10sp"
            android:background="@drawable/bg_usage_icon_circle" />

        <!-- 서비스명 -->
        <TextView
            android:id="@+id/tvExpenseServiceName"
            android:layout_width="82dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="넷플릭스"
            android:textColor="@color/appblack"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 지출 막대그래프 -->
        <ProgressBar
            android:id="@+id/progressExpenseAmount"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="10dp"
            android:progress="50"
            android:max="100"
            android:progressTint="@color/pastel_blue"
            android:progressBackgroundTint="@color/pri50" />

        <!-- 지출 금액 -->
        <TextView
            android:id="@+id/tvExpenseServicePrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₩4,269"
            android:textColor="@color/appblack"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/appwhite"
    android:orientation="vertical">

    <include layout="@layout/common_sub_header" />

    <FrameLayout
        android:layout_width="350dp"
        android:layout_height="160dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_container_gray50_round16">

        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="start|top"
            android:layout_marginStart="20dp"
            android:layout_marginTop="35dp"
            android:contentDescription="프로필 이미지"
            android:src="@drawable/ic_profile_pic" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="130dp"
            android:layout_marginTop="50dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="쥐이카와 님"
                android:textColor="@color/appblack"
                style="@style/typo_body_m1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="20220201@sungshin.ac.kr"
                android:textColor="@color/gray600"
                style="@style/typo_body_m3" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_outline_account_button"
        android:gravity="center"
        android:text="닉네임 변경하기"
        android:textColor="@color/appblack"
        style="@style/typo_body_m1" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_account_logout_button"
        android:gravity="center"
        android:text="로그아웃"
        android:textColor="@color/pri800"
        style="@style/typo_body_m1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:text="회원 탈퇴하기"
        android:textColor="@color/gray500"
        style="@style/typo_body_m2" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="350dp"
    android:layout_height="400dp"
    android:background="@drawable/bg_modal"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <ImageView
        android:id="@+id/access_modal_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="end"
        android:layout_marginTop="16dp"
        android:contentDescription="닫기"
        android:src="@drawable/ic_modal_close"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="앱 사용 기록 접근 권한이 필요합니다"
        android:textColor="@color/appblack"
        style="@style/typo_title_b2" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:text="구독 서비스의 실제 이용 시간을 확인하기 위해\n휴대폰의 앱 사용 기록에 접근합니다.\n사용 시간은 구독 서비스 이용량을 분석하고\n구독 유지 여부를 추천하는 데에만 사용됩니다."
        android:textColor="@color/appblack"
        style="@style/typo_body_m2" />

    <TextView
        android:id="@+id/access_modal_open_settings"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_access_permission_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="접근 허용하러 가기"
        android:textColor="@color/pri700"
        style="@style/typo_body_m1" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/appwhite"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_welcome"
        android:layout_width="364dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        android:text="쥐이카와 님, 반가워요!"
        android:textColor="@color/gray600"
        android:gravity="start"
        style="@style/typo_title_b1" />

    <TextView
        android:layout_width="364dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="섭메이트와 똑똑한 구독 관리 시작해 볼까요?"
        android:textColor="@color/gray600"
        style="@style/typo_title_b2" />

    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:src="@drawable/logo_big" />

    <com.example.submate.presentation.common.view.SubmateButton
        android:id="@+id/btn_go_login"
        android:layout_width="364dp"
        android:layout_height="56dp"
        android:layout_marginTop="70dp"
        android:background="@drawable/bg_submate_button"
        android:text="로그인하러 가기"
        android:textColor="@color/appwhite"
        style="@style/typo_body_m1" />

</LinearLayout>
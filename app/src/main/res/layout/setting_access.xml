<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/appwhite"
    android:orientation="vertical">

    <include layout="@layout/common_sub_header" />

    <TextView
        android:layout_width="350dp"
        android:layout_height="160dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_container_gray50_round16"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="구독 서비스의 실제 이용 시간을 확인하기 위해\n휴대폰의 앱 사용 기록에 접근합니다.\n사용 시간은 구독 서비스 이용량을 분석하고\n구독 유지 여부를 추천하는 데에만 사용됩니다."
        android:textColor="@color/appblack"
        style="@style/typo_body_m1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/bg_access_permission_button"
        android:gravity="center"
        android:text="접근 허용하러 가기"
        android:textColor="@color/pri700"
        style="@style/typo_body_m1" />
</LinearLayout>
